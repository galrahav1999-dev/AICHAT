# =====================================================================
# Mapbox access token for the 2D Map view.
#
# 1. Create a free token at https://account.mapbox.com/access-tokens/
# 2. Copy this file to `.env.local`
# 3. Paste your token below (it must start with `pk.`)
#
# The app runs fine WITHOUT a token — the Globe and List/Board views work
# fully, and the Map view shows a friendly "add your token" placeholder.
# =====================================================================
NEXT_PUBLIC_MAPBOX_TOKEN=
